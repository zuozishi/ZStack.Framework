<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ZStack.Framework.Templates.WebApi</PackageId>
    <PackageVersion>10.9.0</PackageVersion>
    <Title>ZStack.Framework ASP.NET Core Web API 模板</Title>
    <Authors>Zuozishi</Authors>
    <Description>基于 ZStack.Framework 创建可组合组件示例的 ASP.NET Core Web API。</Description>
    <PackageTags>dotnet-new;templates;zstack;aspnetcore;components</PackageTags>
    <PackageProjectUrl>https://github.com/zuozishi/ZStack.Framework</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageType>Template</PackageType>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="src\**\*" Exclude="src\**\bin\**;src\**\obj\**" />
    <Compile Remove="**\*" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
